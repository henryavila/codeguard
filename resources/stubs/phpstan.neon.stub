# ==============================================================================
# PHPStan configuration for CodeGuard
# ------------------------------------------------------------------------------
# PHPStan is a static analyzer that catches bugs without running code.
# Docs: https://phpstan.org/user-guide/rule-levels
# Config reference: https://phpstan.org/config-reference
# Run: vendor/bin/phpstan analyse
# ==============================================================================

includes:
    - vendor/larastan/larastan/extension.neon  # @codeguard:ext=larastan

    # Carbon-aware static analysis — types Carbon::macro() returns + DatePeriod
    # Bundled with nesbot/carbon (transitive dep in every Laravel project), so
    # there is zero install cost. Always on — not toggleable via the wizard.
    - vendor/nesbot/carbon/extension.neon

    # PHPStan-PHPUnit — required for Pest (runs on top of PHPUnit)
    - vendor/phpstan/phpstan-phpunit/extension.neon  # @codeguard:ext=phpunit
    - vendor/phpstan/phpstan-phpunit/rules.neon  # @codeguard:ext=phpunit

    # Peststan — teaches PHPStan about $this inside Pest closures.
    # Opt-in: auto-selected when pestphp/pest is in the consumer's composer.json.
    - vendor/mrpunyapal/peststan/extension.neon  # @codeguard:ext=peststan

    # Cognitive complexity — Sonar-style metric measuring reader mental overhead
    - vendor/tomasvotruba/cognitive-complexity/config/extension.neon  # @codeguard:ext=cognitive-complexity

    # Dead code detector — unused methods/constants/properties with Laravel awareness
    - vendor/shipmonk/dead-code-detector/rules.neon  # @codeguard:ext=dead-code

    # Disallowed calls — bans dd(), var_dump(), etc. in production code
    - vendor/spaze/phpstan-disallowed-calls/extension.neon  # @codeguard:ext=disallowed-calls

    # CodeGuard test-quality kit — bans Laravel testing anti-patterns
    - phpstan-test-quality.neon  # @codeguard:ext=test-quality

    # Baseline — snapshot of CURRENT errors so you can bump level without fixing
    # everything at once. Generate with:
    #   vendor/bin/phpstan analyse --generate-baseline
    # Commit phpstan-baseline.neon and fix entries incrementally.
    # - phpstan-baseline.neon

parameters:
    # --------------------------------------------------------------------------
    # Rule level: 0 (loose) to 10 (max strict).
    # Reference: https://phpstan.org/user-guide/rule-levels
    #   0  — basic checks, unknown classes/functions
    #   3  — return types, property assignment types
    #   5  — argument types passed to methods    <-- CodeGuard default
    #   8  — calling methods / accessing properties on nullable types
    #   10 — every type must be explicit (nothing implicit)
    # Tip: raise gradually. Each bump uncovers real bugs you can fix in a PR.
    # --------------------------------------------------------------------------
    level: 5

    paths:
        - app
        - database
        - routes
        # Add `tests` once your test suite is PHPStan-clean.

    excludePaths:
        analyseAndScan:
            - storage
            - bootstrap/cache
            # Add project-specific exclusions below:
            # - app/Legacy/*

    # Infer private property types from the constructor when not explicitly
    # annotated. Safe, zero behavior change, improves inference precision.
    inferPrivatePropertyTypeFromConstructor: true

    # Enforce class-name casing (Foo vs foo). Catches bugs on case-sensitive
    # filesystems (Linux CI + macOS dev). Laravel/Composer autoload is
    # case-sensitive on Linux — this prevents environment-specific breakage.
    checkClassCaseSensitivity: true

    # Larastan-only option: inspects Eloquent $fillable/$casts/migrations to
    # type model properties. No-op without larastan, harmless to leave on.
    checkModelProperties: true

    # Report unused @phpstan-ignore comments (ignore markers with no matching
    # error below them). Keeps the ignore list honest as code evolves.
    reportUnmatchedIgnoredErrors: true

    # ignoreErrors lets you silence specific patterns. Prefer baseline over
    # this list when possible — baselines are auto-managed.
    ignoreErrors: []

    # --------------------------------------------------------------------------
    # Peststan — Pest-aware typing. Set testCaseClass to the project's Pest
    # base case (Tests\TestCase by default in a standard Laravel Pest layout).
    # --------------------------------------------------------------------------
    # @codeguard:ext=peststan:params:start
    peststan:
        testCaseClass: Tests\TestCase
    # @codeguard:ext=peststan:params:end

    # --------------------------------------------------------------------------
    # Cognitive Complexity thresholds (Laravel-calibrated defaults)
    # --------------------------------------------------------------------------
    # @codeguard:ext=cognitive-complexity:params:start
    cognitive_complexity:
        class: 50       # typical Laravel controller+service range
        function: 15    # individual method reasonable upper bound
    # @codeguard:ext=cognitive-complexity:params:end

    # --------------------------------------------------------------------------
    # Dead Code Detector (shipmonk/dead-code-detector)
    # `laravel` / `eloquent` usageProviders were removed in 0.14 — the
    # built-in vendor provider already tracks framework-driven usage.
    # --------------------------------------------------------------------------
    # @codeguard:ext=dead-code:params:start
    shipmonkDeadCode:
        detect:
            deadMethods: true
            deadConstants: true
            deadEnumCases: true
            deadProperties:
                neverRead: true
                neverWritten: true
    # @codeguard:ext=dead-code:params:end

    # --------------------------------------------------------------------------
    # Disallowed Function/Method Calls — Laravel production anti-patterns
    # --------------------------------------------------------------------------
    # @codeguard:ext=disallowed-calls:params:start
    disallowedFunctionCalls:
        -
            function: 'dd()'
            message: 'Use logger() or proper debugging. dd() crashes production.'
        -
            function: 'dump()'
            message: 'Not for production — use logger()->debug() or xdebug.'
        -
            function: 'var_dump()'
            message: 'Use logger() — var_dump() leaks to stdout in production.'
        -
            function: 'print_r()'
            message: 'Use logger() — print_r() leaks to stdout.'
        -
            function: 'die()'
            message: 'Throw an exception instead — die() bypasses error handlers.'
        -
            function: 'exit()'
            message: 'Throw an exception instead — exit() bypasses error handlers.'

    disallowedStaticCalls:
        -
            method: 'Illuminate\Support\Env::get()'
            message: 'env() is only valid inside config/ files (cached in production). Use config() elsewhere.'
            allowIn:
                - config/*
    # @codeguard:ext=disallowed-calls:params:end
