# ==============================================================================
# PHPStan configuration for CodeGuard
# ------------------------------------------------------------------------------
# PHPStan is a static analyzer that catches bugs without running code.
# Docs: https://phpstan.org/user-guide/rule-levels
# Config reference: https://phpstan.org/config-reference
# Run: vendor/bin/phpstan analyse
# ==============================================================================

includes:
    # Larastan adds Laravel-specific rules (Eloquent relation types, facade
    # resolution, view/config helpers). Uncomment after
    # `composer require --dev larastan/larastan`. Without it, Laravel "magic"
    # appears as "mixed" everywhere and PHPStan misses real issues.
    # - vendor/larastan/larastan/extension.neon

    # Baseline file — snapshot of CURRENT errors so you can bump the level
    # without fixing everything at once. Generate with:
    #   vendor/bin/phpstan analyse --generate-baseline
    # Commit phpstan-baseline.neon and fix entries incrementally.
    # - phpstan-baseline.neon

parameters:
    # --------------------------------------------------------------------------
    # Rule level: 0 (loose) to 10 (max strict).
    # Reference: https://phpstan.org/user-guide/rule-levels
    #   0  — basic checks, unknown classes/functions
    #   1  — undefined variables, unknown magic methods
    #   2  — unknown methods on all expressions (not just $this)
    #   3  — return types, property assignment types
    #   4  — dead code (always-true conditions, unreachable branches)
    #   5  — argument types passed to methods    <-- CodeGuard default
    #   6  — missing typehints
    #   7  — partially wrong union types
    #   8  — calling methods / accessing properties on nullable types
    #   9  — strict mixed (narrow before use)
    #   10 — every type must be explicit (nothing implicit)
    # Tip: raise gradually. Each bump uncovers real bugs you can fix in a PR.
    # --------------------------------------------------------------------------
    level: 5

    # Paths to analyze. Keep narrow — bigger = slower.
    paths:
        - app
        - config
        - database
        - routes
        # Add `tests` once your test suite is PHPStan-clean.

    # Paths to skip entirely. Use `analyseAndScan` (not `analyse`) so PHPStan
    # still knows these classes exist but won't report errors inside them.
    excludePaths:
        analyseAndScan: []
            # - app/Legacy/*
            # - database/migrations/2019_*.php

    # PHPDoc types can lie (they're comments, not enforced). Setting this to
    # FALSE makes PHPStan verify the code actually matches the docblock,
    # catching stale @var/@return tags after refactors. Highly recommended.
    treatPhpDocTypesAsCertain: false

    # Larastan-only option: inspects Eloquent $fillable/$casts/migrations to
    # type model properties. Only takes effect when the larastan extension is
    # loaded (see `includes` above). Safe to leave true even without larastan.
    checkModelProperties: true

    # Report unused @phpstan-ignore comments (ignore markers with no matching
    # error below them). Keeps the ignore list honest as code evolves.
    reportUnmatchedIgnoredErrors: true

    # ignoreErrors lets you silence specific patterns. Prefer the baseline
    # approach over this list when possible — baselines are auto-managed.
    ignoreErrors: []
        # - '#Call to an undefined method .+::scope[A-Z].+#'
