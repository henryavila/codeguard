# ==============================================================================
# Deptrac configuration for CodeGuard (Laravel 4-layer architecture)
# ------------------------------------------------------------------------------
# Deptrac enforces architectural boundaries at static-analysis time.
#
# Core concepts:
#   - Layers     : named buckets of classes (Domain, Application, ...)
#   - Collectors : rules that match classes to layers (regex, attribute, ...)
#   - Ruleset    : which layers are ALLOWED to depend on which other layers.
#                  Anything NOT listed = forbidden = violation.
#
# Docs:       https://deptrac.github.io/deptrac/latest/
# Collectors: https://deptrac.github.io/deptrac/latest/collectors/
# Run:        vendor/bin/deptrac analyse
# ==============================================================================

deptrac:
    # Paths Deptrac scans for PHP classes.
    paths:
        - ./app

    # Files excluded from analysis. PCRE regex delimited by '#'.
    exclude_files:
        - '#.*test.*#i'
        - '#.*[Dd]atabase/(Migrations|Factories|Seeders).*#'

    # --------------------------------------------------------------------------
    # LAYERS — what goes where, and what does NOT.
    #
    # Mental model for a Laravel app:
    #
    #   [Presentation]  HTTP / Livewire / Filament / Console
    #        ↓ depends on
    #   [Application]   Services / Jobs / Events / Notifications
    #        ↓ depends on
    #   [Domain]        Entities / Value Objects / Policies (pure PHP)
    #        ↑ implemented by
    #   [Infrastructure] Eloquent Models / Repositories / API clients
    # --------------------------------------------------------------------------
    layers:
        # ----------------------------------------------------------------------
        # DOMAIN — pure business rules.
        # IN : App\Domain, App\ValueObjects, App\Policies, App\Enums,
        #      App\Contracts, App\Interfaces, App\Rules, App\Abstracts
        # OUT: Models (they are Eloquent adapters → Infrastructure),
        #      Controllers, Services, Framework-bound code.
        # ----------------------------------------------------------------------
        - name: Domain
          collectors:
              - type: classLike
                value: ^App\\(Domain|ValueObjects|Policies|Enums|Contracts|Interfaces|Rules|Abstracts)\\.*

        # ----------------------------------------------------------------------
        # APPLICATION — orchestration. Runs use-cases, coordinates Domain.
        # IN : App\Services, App\Jobs, App\Events, App\Listeners,
        #      App\Observers, App\Notifications, App\Mail, App\Actions,
        #      App\UseCases, App\Exports, App\DTOs, App\Dto, App\Pipes,
        #      App\Features
        # OUT: Controllers / Livewire (transports, not orchestration).
        # ----------------------------------------------------------------------
        - name: Application
          collectors:
              - type: classLike
                value: ^App\\(Services|Jobs|Events|Listeners|Observers|Notifications|Mail|Actions|UseCases|Exports|DTOs|Dto|Pipes|Features)\\.*

        # ----------------------------------------------------------------------
        # PRESENTATION — entry points / transports.
        # IN : App\Http (Controllers, Middleware, Requests, Resources),
        #      App\Livewire, App\Filament, App\Nova, App\Console (CLI),
        #      App\Forms, App\View, App\Presenters
        # OUT: Business logic — those go in Application/Domain and are
        #      CALLED from here.
        # ----------------------------------------------------------------------
        - name: Presentation
          collectors:
              - type: classLike
                value: ^App\\(Http|Livewire|Filament|Nova|Console|Forms|View|Presenters)\\.*

        # ----------------------------------------------------------------------
        # INFRASTRUCTURE — adapters to external systems.
        # IN : App\Models (Eloquent), App\Repositories, App\Eloquent,
        #      App\Infrastructure, App\Adapters
        # OUT: Business rules (Eloquent model methods should be thin —
        #      push rules into Domain/Application).
        # ----------------------------------------------------------------------
        - name: Infrastructure
          collectors:
              - type: classLike
                value: ^App\\(Models|Repositories|Eloquent|Infrastructure|Adapters)\\.*

    # --------------------------------------------------------------------------
    # NOT IN ANY LAYER (intentional) — cross-cutting / bootstrap.
    #
    # These live under app/ but are legitimately called by every layer, so
    # classifying them triggers many false-positive violations:
    #
    #   • App\Providers\*   → framework bootstrap (routes, policies, bindings)
    #   • App\Exceptions\*  → throw/catch cross layer boundaries
    #   • App\Traits\*      → mixins reused by models, services, controllers
    #   • App\Helpers\*     → global utilities
    #
    # The CodeGuard wizard auto-suggests "Skip" for these. If your project
    # has others (e.g. App\Objects), the wizard will prompt you case by case.
    # --------------------------------------------------------------------------

    # --------------------------------------------------------------------------
    # RULESET — allowed dependencies between layers.
    # '~' (tilde) = null = "this layer may depend on NOTHING in our ruleset".
    # Any dependency not listed here triggers a violation.
    # --------------------------------------------------------------------------
    ruleset:
        # Domain is sacred — zero outbound dependencies on our layers.
        # (Can still use PHP stdlib, Carbon, etc. — only OUR layers are enforced.)
        Domain: ~

        # Application orchestrates Domain. It must NOT reach Presentation
        # or Infrastructure directly; depend on Domain contracts instead.
        Application:
            - Domain

        # Infrastructure implements Domain contracts (Eloquent, repos, adapters).
        # It knows Domain, but Domain must never know Infrastructure.
        Infrastructure:
            - Domain

        # Presentation is the outermost ring — may call Application and
        # read Domain types, but NEVER touches Infrastructure directly
        # (no Eloquent queries in controllers; go through a Service).
        Presentation:
            - Application
            - Domain

    # --------------------------------------------------------------------------
    # Optional: baseline to grandfather existing violations during adoption.
    # Generate with: vendor/bin/deptrac analyse --formatter=baseline
    # --------------------------------------------------------------------------
    # baseline_file: deptrac-baseline.yaml

    # --------------------------------------------------------------------------
    # Optional: formatters control report output. Default is console table.
    # Uncomment for CI-friendly output:
    # formatters:
    #     github-actions:
    #         report_uncovered: true
    #     json:
    #         dump_file: ./deptrac-report.json
    # --------------------------------------------------------------------------
