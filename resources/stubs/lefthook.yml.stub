# Lefthook — fast, parallel Git hooks manager (Go binary, zero runtime deps)
# Docs: https://lefthook.dev
# Config reference: https://lefthook.dev/configuration/
#
# WHY LEFTHOOK?
# Native Git hooks are shell scripts that developers often bypass or forget.
# Lefthook runs in parallel, only on staged files, and is trivially installed
# via `lefthook install`. It enforces quality gates BEFORE code enters Git.
#
# TEMPLATE VARIABLES used below:
#   {staged_files}  -> space-separated list of files staged for commit
#   {push_files}    -> files being pushed
#   {all_files}     -> every tracked file (use sparingly — slow on large repos)

pre-commit:
  # parallel: true runs all commands concurrently. Safe because each command
  # operates on its own file set and does not contend for shared resources.
  # Use `piped: true` instead if commands depend on each other's output.
  parallel: true

  commands:
    # Laravel Pint — opinionated PHP-CS-Fixer wrapper (PSR-12 + Laravel preset)
    # Docs: https://laravel.com/docs/pint
    pint:
      # `glob` filters {staged_files} to only PHP sources. Without this,
      # Pint would be invoked with non-PHP paths and fail noisily.
      glob: "*.php"

      # {staged_files} expands to only the files currently staged — this keeps
      # the hook fast even in large repos (you don't re-format the whole tree).
      run: vendor/bin/pint {staged_files}

      # stage_fixed: true re-stages any files Pint modified so the formatting
      # changes are INCLUDED in the commit (instead of appearing as unstaged
      # changes after the commit completes).
      stage_fixed: true

    # PHPStan — static analysis at level max (configured in phpstan.neon.dist)
    # Docs: https://phpstan.org
    phpstan:
      glob: "*.php"
      # --no-progress keeps hook output clean; memory-limit bumped for level max.
      run: vendor/bin/phpstan analyse {staged_files} --no-progress --memory-limit=1G

pre-push:
  # pre-push runs once before `git push`. Heavier checks belong here rather
  # than pre-commit, so local commits stay fast.
  commands:
    pest:
      # --bail exits on the first failing test, giving faster feedback when
      # something is broken. Remove --bail if you want the full report.
      run: vendor/bin/pest --bail

# SKIPPING HOOKS
# Developers can bypass with: `git commit --no-verify` (discouraged; enforce via CI).
# Configure per-command `skip: [merge, rebase]` to auto-skip during merges/rebases.
# Configure `skip: ci` + env var LEFTHOOK=0 to disable entirely in CI pipelines
# (CI should run the same checks via composer scripts, not via git hooks).
