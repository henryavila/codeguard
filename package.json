{
  "name": "@henryavila/codeguard",
  "version": "0.1.1",
  "description": "AI-powered code quality guardian — enforces project standards via pre-commit hooks and on-demand analysis",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/henryavila/codeguard.git"
  },
  "homepage": "https://github.com/henryavila/codeguard",
  "bugs": {
    "url": "https://github.com/henryavila/codeguard/issues"
  },
  "keywords": [
    "code-quality",
    "static-analysis",
    "laravel",
    "php",
    "pre-commit",
    "architecture",
    "patterns",
    "ai"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "codeguard": "bin/codeguard.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./hook-runner": "./dist/hooks/runner.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist/",
    "bin/",
    "skills/",
    "modules/"
  ],
  "scripts": {
    "prebuild": "tsx scripts/generate-module-registry.ts",
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/",
    "format": "prettier --write .",
    "dev": "tsx watch src/index.ts"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.3.2",
    "ajv": "^8.18.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "deepmerge": "^4.3.1",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.8.1",
    "tsdown": "^0.21.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
